{
  "name": "identity-vault",
  "version": "1.0.0",
  "description": "AI-powered identity profiling system with Telegram integration",
  "main": "backend/server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "build": "echo 'No build step needed'"
    "dev:backend": "cd backend && npm run dev",
    "dev:bot": "cd telegram-bot && npm run dev",
    "dev:frontend": "cd frontend/mini-app && npm start",
    "start:backend": "cd backend && npm start",
    "start:bot": "cd telegram-bot && npm start",
    "test:bot": "cd telegram-bot && npm test",
    "attack": "node security/run-attacks.js",
    "docker:up": "docker-compose -f infrastructure/docker-compose.yml up",
    "docker:down": "docker-compose -f infrastructure/docker-compose.yml down",
    "docker:build": "docker-compose -f infrastructure/docker-compose.yml build",
    "deploy:railway": "echo 'Push to GitHub and Railway will auto-deploy'",
    "deploy:heroku": "bash infrastructure/deploy.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.1.2",
    "bcrypt": "^5.1.1",
    "sqlite3": "^5.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "keywords": ["identity", "security", "telegram", "ai", "verification", "railway"],
  "author": "",
  "license": "MIT"
}
